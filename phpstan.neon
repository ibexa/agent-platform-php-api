parameters:
    level: 8
    phpVersion: 80300
    treatPhpDocTypesAsCertain: false
    paths:
        - src/lib
        - tests
        - generator
    # Empty generated models retain the shared constructor for API compatibility.
    ignoreErrors:
        -
            identifier: constructor.unusedParameter
            message: '~^Constructor of class Ibexa\\AgentPlatform\\Model\\(Amount|BlocksInner|CreditsMax|CreditsMin|LocationInner|MaxTextInputPrice|MonthlyAllowance|Value|Value1|X) has an unused parameter \$data\.$~'
            path: src/lib/Model/*
            count: 10
